--- a/drivers/nvmem/Kconfig
+++ b/drivers/nvmem/Kconfig
@@ -314,6 +314,14 @@ config NVMEM_RCAR_EFUSE
 	  This driver can also be built as a module. If so, the module
 	  will be called nvmem-rcar-efuse.
 
+config NVMEM_RTL960X_OTP
+	tristate "Realtek RTL960x SoCs OTP/Efuse support"
+	depends on (MACH_REALTEK_RTL && RTL960X) || COMPILE_TEST
+	select REGMAP_MMIO
+	help
+	  Enable support for reading the fuses in the E-FUSE or OTP
+	  non-volatile memory block on Realtek RTL960x SoCs.
+
 config NVMEM_RMEM
 	tristate "Reserved Memory Based Driver Support"
 	depends on HAS_IOMEM
--- a/drivers/nvmem/Makefile
+++ b/drivers/nvmem/Makefile
@@ -62,6 +62,8 @@ obj-$(CONFIG_NVMEM_RAVE_SP_EEPROM)	+= nv
 nvmem-rave-sp-eeprom-y			:= rave-sp-eeprom.o
 obj-$(CONFIG_NVMEM_RCAR_EFUSE)		+= nvmem-rcar-efuse.o
 nvmem-rcar-efuse-y			:= rcar-efuse.o
+obj-$(CONFIG_NVMEM_RTL960X_EFUSE)	+= nvmem_rtl960x-otp.o
+nvmem_rtl960x-otp-y			:= rtl960x-otp.o
 obj-$(CONFIG_NVMEM_RMEM) 		+= nvmem-rmem.o
 nvmem-rmem-y				:= rmem.o
 obj-$(CONFIG_NVMEM_ROCKCHIP_EFUSE)	+= nvmem_rockchip_efuse.o
